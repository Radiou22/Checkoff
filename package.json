{
  "name": "checkoff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "setup": "node scripts/setup.ts",
    "coverage:backend": "node scripts/coverage-backend.ts"
  },
  "devDependencies": {
    "@checkoff/eslint": "workspace:*",
    "@types/node": "^24.0.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3"
  }
}
